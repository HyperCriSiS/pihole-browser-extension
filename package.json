{
	"name": "pihole-browser-extension",
	"version": "4.2.0",
	"dependencies": {
		"axios": "^1.18.1",
		"vue": "^3.5.40",
		"vue-debounce": "^5.0.1",
		"vue-router": "^5.2.0",
		"vuetify": "^4.1.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mdi/js": "^7.4.47",
		"@types/chrome": "^0.2.2",
		"@types/firefox-webext-browser": "^143.0.0",
		"@types/zip-webpack-plugin": "^3.0.6",
		"@vue/compiler-sfc": "^3.5.40",
		"copy-webpack-plugin": "^14.0.0",
		"cross-env": "^10.1.0",
		"css-loader": "^7.1.4",
		"deepmerge": "^4.3.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.10.0",
		"eslint-webpack-plugin": "^6.0.0",
		"globals": "^16.4.0",
		"html-webpack-plugin": "^5.6.8",
		"prettier": "3.9.6",
		"sass": "^1.102.0",
		"sass-loader": "^17.0.0",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.65.0",
		"vue-eslint-parser": "^10.4.0",
		"vue-loader": "^17.4.2",
		"webpack": "^5.109.0",
		"webpack-cli": "^7.2.1",
		"zip-webpack-plugin": "^4.0.3"
	},
	"description": "Browser extension to control your PiHole. Built with Vue, Typescript and ❤",
	"scripts": {
		"start-chrome": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=development -w --progress --config src/webpack/webpack.chrome.ts",
		"start-firefox": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=development -w --progress --config src/webpack/webpack.firefox.ts",
		"build": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=production --progress --config src/webpack/webpack.firefox.ts && cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=production --progress --config src/webpack/webpack.chrome.ts",
		"rebuild-package-lock": "npm install --package-lock",
		"eslint": "eslint .",
		"prettier-check": "prettier --check ./**/*.{ts,vue,css,scss,js,mjs}",
		"prettier-format": "prettier --write ./**/*.{ts,vue,css,scss,js,mjs}",
		"test:domain-status": "node --experimental-strip-types --experimental-default-type=module --test tests/domain-status.test.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HyperCriSiS/pihole-browser-extension.git"
	},
	"keywords": [
		"pihole",
		"extension",
		"chrome",
		"firefox",
		"vue",
		"typescript"
	],
	"author": "Pascal Glaser",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/HyperCriSiS/pihole-browser-extension/issues"
	},
	"homepage": "https://github.com/HyperCriSiS/pihole-browser-extension#readme"
}
